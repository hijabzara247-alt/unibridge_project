# Copy this file to .env and fill in your real values. Never commit the real .env file.

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/unibridge

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_key

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Port the Express server listens on
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:3000
